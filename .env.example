# 로컬 개발은 이 파일을 .env.local 로 복사해서 씁니다. Vercel에서는 프로젝트 환경 변수로 넣습니다.

# Postgres 접속 주소. Vercel에서 Neon을 연결하면 자동으로 들어갑니다.
# 로컬: `docker compose up -d` 후 아래 값을 그대로 쓰면 됩니다.
DATABASE_URL=postgres://postgres:dev@localhost:5432/linkmatch

# Vercel 미리보기 배포 전용 DB. 미리보기(VERCEL_ENV=preview)에서는 이 값만 쓰고 운영 DB는 쓰지 않습니다.
PREVIEW_DATABASE_URL=

# 운영진(관리자) 토큰. 프로덕션에서 비워두면 관리자 API가 전부 막힙니다.
# 32자 이상 무작위 값을 쓰세요. 예: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 개발 모드에서 비워두면 "dev-admin"이 쓰입니다.
ADMIN_TOKEN=

# Vercel에서는 설정하지 않습니다 (Vercel이 덮어쓰는 IP 헤더를 자동으로 씁니다).
# 그 밖의 서버에서는 x-forwarded-for / cf-connecting-ip 를 덮어쓰는 프록시 뒤에서만 1로 설정.
# 설정하지 않으면 모든 요청을 한 묶음으로 보고 대입 시도를 제한합니다.
TRUST_PROXY=

# 운영 환경에서 "샘플 데이터 넣기"(전체 삭제 후 예시 데이터)를 허용하려면 1. 기본은 차단.
ALLOW_SAMPLE_SEED=

# 백업 (npm run backup)
BACKUP_DIR=
KEEP=14
