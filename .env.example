# 운영진(관리자) 토큰. 프로덕션에서 비워두면 관리자 API가 전부 막힙니다.
# 32자 이상 무작위 값을 쓰세요. 예: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 개발 모드에서 비워두면 "dev-admin"이 쓰입니다.
ADMIN_TOKEN=

# SQLite 파일 경로 (기본값: ./data/linkmatch.sqlite). 운영·테스트 환경은 서로 다른 파일을 쓰세요.
DB_PATH=

# Cloudflare·Vercel·nginx 등 x-forwarded-for / cf-connecting-ip 를 덮어쓰는 프록시 뒤에서만 1로 설정.
# 설정하지 않으면 모든 요청을 한 묶음으로 보고 대입 시도를 제한합니다.
TRUST_PROXY=

# 운영 환경에서 "샘플 데이터 넣기"(전체 삭제 후 예시 데이터)를 허용하려면 1. 기본은 차단.
ALLOW_SAMPLE_SEED=

# 백업 (npm run backup)
BACKUP_DIR=
KEEP=14
