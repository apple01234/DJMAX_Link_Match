{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/lib/client": ["./src/mock/client.ts"],
      "@/lib/repo": ["./src/mock/repo.ts"],
      "next/link": ["./src/shims/next.tsx"],
      "next/navigation": ["./src/shims/next.tsx"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
