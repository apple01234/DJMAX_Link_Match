# DOMAIN에 도메인을 넣으면 Caddy가 HTTPS 인증서를 자동으로 발급·갱신한다.
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		# 앱은 TRUST_PROXY=1일 때 cf-connecting-ip → x-real-ip → x-forwarded-for 순서로 접속 IP를 읽는다.
		# 클라이언트가 보낸 값을 지우고, Caddy가 직접 본 접속 IP만 넘겨서 대입 제한을 우회하지 못하게 한다.
		# (Cloudflare를 앞에 둘 때는 이 두 줄을 지우고 Cloudflare IP 대역만 trusted_proxies로 허용할 것)
		header_up -Cf-Connecting-Ip
		header_up X-Real-IP {remote_host}
	}
}
